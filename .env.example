DISCORD_TOKEN=
GUILD_ID=
EVENT_STAFF_ROLE_ID=

# General member role allowed to use /register (not staff-only, not open to anyone)
WARBOY_ROLE_ID=

# RDS PostgreSQL (us-east-1, co-located with the bot). Holds matchmaking/ELO
# tables plus all bot runtime state: registrations, event category state,
# round state (map channels/threads).
PGHOST=furiosa-db.c43i6su88bsx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE_PROD=furyroad
PGDATABASE_TEST=furyroad_test
PGUSER=furiosa
PGPASSWORD=

# Set to "true" only in the furiosa-test systemd instance's .env — routes all
# of this instance's runtime state (registrations/category/round state) to
# PGDATABASE_TEST instead of PGDATABASE_PROD. Leave unset/false on furiosa-prod.
DB_IS_TEST_INSTANCE=
